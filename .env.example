# Copy to .env (or set in your host) and fill with YOUR Supabase project values.
# Never commit real keys. Never put the service_role key in the frontend.

# Project URL from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key (same page). NOT the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional alias some tooling uses; the client also accepts this name.
# VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
