import { cn } from "@/lib/utils";
import type { ContinentRow } from "@/lib/world";

/** Lightweight schematic map — no map SDK, no user pins. */
const CONTINENT_LAYOUT: Array<{
  code: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
}> = [
  { code: "NA", label: "N. America", x: 8, y: 18, w: 22, h: 28 },
  { code: "SA", label: "S. America", x: 18, y: 52, w: 14, h: 30 },
  { code: "EU", label: "Europe", x: 42, y: 16, w: 14, h: 18 },
  { code: "AF", label: "Africa", x: 42, y: 38, w: 16, h: 32 },
  { code: "AS", label: "Asia", x: 58, y: 14, w: 28, h: 36 },
  { code: "OC", label: "Oceania", x: 72, y: 58, w: 18, h: 18 },
  { code: "AN", label: "Antarctica", x: 30, y: 88, w: 40, h: 8 },
];

interface WorldMapProps {
  continents: ContinentRow[];
  selectedContinent: string | null;
  onSelectContinent: (code: string) => void;
  className?: string;
}

export function WorldMap({
  continents,
  selectedContinent,
  onSelectContinent,
  className,
}: WorldMapProps) {
  const byCode = Object.fromEntries(continents.map((c) => [c.code, c]));

  return (
    <div className={cn("overflow-hidden rounded-3xl bg-panel ring-1 ring-line", className)}>
      <div className="flex items-center justify-between px-4 pt-3">
        <span className="font-display text-[10px] font-semibold tracking-[0.2em] text-mist">
          WORLD MAP
        </span>
        <span className="text-[10px] text-mist">Aggregated only · no pins</span>
      </div>
      <svg
        viewBox="0 0 100 100"
        className="mt-1 h-44 w-full touch-manipulation sm:h-52"
        role="img"
        aria-label="OTAKUVERSE world map by continent"
      >
        {CONTINENT_LAYOUT.map((region) => {
          const active = selectedContinent === region.code;
          const hasData = byCode[region.code];
          return (
            <g key={region.code}>
              <rect
                x={region.x}
                y={region.y}
                width={region.w}
                height={region.h}
                rx={2.5}
                className={cn(
                  "cursor-pointer transition-all",
                  active ? "fill-neon/35 stroke-neon" : "fill-panel2 stroke-line hover:fill-neon/15",
                )}
                strokeWidth={0.6}
                onClick={() => onSelectContinent(region.code)}
              />
              <text
                x={region.x + region.w / 2}
                y={region.y + region.h / 2}
                textAnchor="middle"
                dominantBaseline="middle"
                className="pointer-events-none fill-snow"
                style={{ fontSize: "3.2px" }}
              >
                {region.label}
              </text>
              {hasData?.member_count != null ? (
                <text
                  x={region.x + region.w / 2}
                  y={region.y + region.h / 2 + 4}
                  textAnchor="middle"
                  className="pointer-events-none fill-mist"
                  style={{ fontSize: "2.4px" }}
                >
                  {hasData.member_count}
                </text>
              ) : null}
            </g>
          );
        })}
      </svg>
      <div className="flex flex-wrap gap-1.5 px-3 pb-3">
        {CONTINENT_LAYOUT.filter((r) => r.code !== "AN").map((region) => (
          <button
            key={region.code}
            type="button"
            onClick={() => onSelectContinent(region.code)}
            className={cn(
              "rounded-full px-2.5 py-1 text-[10px] font-medium ring-1",
              selectedContinent === region.code
                ? "bg-neon/15 text-neon ring-neon/40"
                : "bg-panel2 text-mist ring-line",
            )}
          >
            {region.label}
          </button>
        ))}
      </div>
    </div>
  );
}
